# Supabase project (Auth only; sign-ups disabled there) — Project Settings > API Keys. Must be the same project the backend's
# SUPABASE_URL points at, or every API call will 401.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Base URL of the Go backend (github.com/GM-Tomas/base_project_go). No trailing slash.
# NEXT_PUBLIC_* values are inlined at build time: after changing it on Vercel, redeploy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
