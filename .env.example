# Supabase project (Auth + Postgres) — get these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Base URL of the backend (base_project/backend). No trailing slash.
# Local dev default (matches backend/bootRun): http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
