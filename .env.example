# Supabase project (Auth + Postgres) — get these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Base URL of the backend (github.com/GM-Tomas/base_project). No trailing slash.
# Local dev default (matches its ./gradlew bootRun): http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
